rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedGoogle() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function approvedOperator() {
      let operator = get(/databases/$(database)/documents/operators/$(request.auth.uid)).data;
      return signedGoogle()
        && operator.uid == request.auth.uid
        && operator.email == request.auth.token.email
        && operator.active == true;
    }

    function currentHolder() {
      let lease = get(/databases/$(database)/documents/system/accessLease).data;
      return approvedOperator()
        && lease.holderUid == request.auth.uid
        && lease.epoch is int
        && lease.updatedAt is timestamp
        && lease.updatedAt + duration.value(5, 'm') > request.time;
    }

    function commandHolder(epoch) {
      let lease = get(/databases/$(database)/documents/system/accessLease).data;
      return approvedOperator()
        && lease.holderUid == request.auth.uid
        && lease.epoch is int
        && lease.epoch == epoch
        && lease.updatedAt is timestamp
        && lease.updatedAt + duration.value(5, 'm') > request.time;
    }

    function exactMap(value, keys) {
      return value is map && value.keys().hasOnly(keys);
    }

    function validId(value) {
      return value is string && value.size() >= 1 && value.size() <= 64 && !value.matches('.*[/].*');
    }

    function validStudentId(value) {
      return validCommandId(value);
    }

    function validStudentCode(value) {
      return value is string && value.matches('^(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,5})$');
    }

    function validDisplayName(value) {
      return value is string && value.size() >= 1 && value.size() <= 100;
    }

    function validAliases(aliases) {
      return aliases is list && aliases.size() <= 10
        && (aliases.size() < 1 || (aliases[0] is string && aliases[0].size() > 0 && aliases[0].size() <= 100))
        && (aliases.size() < 2 || (aliases[1] is string && aliases[1].size() > 0 && aliases[1].size() <= 100))
        && (aliases.size() < 3 || (aliases[2] is string && aliases[2].size() > 0 && aliases[2].size() <= 100))
        && (aliases.size() < 4 || (aliases[3] is string && aliases[3].size() > 0 && aliases[3].size() <= 100))
        && (aliases.size() < 5 || (aliases[4] is string && aliases[4].size() > 0 && aliases[4].size() <= 100))
        && (aliases.size() < 6 || (aliases[5] is string && aliases[5].size() > 0 && aliases[5].size() <= 100))
        && (aliases.size() < 7 || (aliases[6] is string && aliases[6].size() > 0 && aliases[6].size() <= 100))
        && (aliases.size() < 8 || (aliases[7] is string && aliases[7].size() > 0 && aliases[7].size() <= 100))
        && (aliases.size() < 9 || (aliases[8] is string && aliases[8].size() > 0 && aliases[8].size() <= 100))
        && (aliases.size() < 10 || (aliases[9] is string && aliases[9].size() > 0 && aliases[9].size() <= 100));
    }

    function validCommandId(value) {
      return value is string
        && value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function validCalendarDate(date) {
      return date is string
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.value(date + 'T00:00:00Z') is timestamp;
    }

    function validTaipeiDate(date) {
      return date is string
        && validCalendarDate(date)
        && timestamp.value(date + 'T00:00:00Z') <= request.time + duration.value(8, 'h');
    }

    function validCurrentTaipeiDate(date) {
      let start = timestamp.value(date + 'T00:00:00Z');
      return validCalendarDate(date)
        && start <= request.time + duration.value(8, 'h')
        && start + duration.value(24, 'h') > request.time + duration.value(8, 'h');
    }

    function validHead(head) {
      return exactMap(head, ['schemaVersion', 'datasetId', 'seq', 'lastCommandId', 'maintenance', 'goLiveDate', 'updatedAt'])
        && head.schemaVersion == 1
        && head.datasetId is string
        && head.datasetId.size() > 0
        && head.seq is int
        && head.seq >= 0
        && (head.lastCommandId == null || head.lastCommandId is string)
        && head.maintenance is bool
        && head.goLiveDate is string
        && validCalendarDate(head.goLiveDate)
        && head.updatedAt is timestamp;
    }

    function validTotals(totals) {
      return totals is map && totals.size() == 8
        && totals.activeTransactionCount is int && totals.activeTransactionCount >= 0
        && totals.bentoCount is int && totals.bentoCount >= 0
        && totals.otherMealCount is int && totals.otherMealCount >= 0
        && totals.mealTotal is int && totals.mealTotal >= 0 && totals.mealTotal <= 1000000000
        && totals.retainedReceipts is int && totals.retainedReceipts >= 0 && totals.retainedReceipts <= 1000000000
        && totals.cashierIncome is int && totals.cashierIncome >= 0 && totals.cashierIncome <= 1000000000
        && totals.cashierExpense is int && totals.cashierExpense >= 0 && totals.cashierExpense <= 1000000000
        && totals.accountRefunds is int && totals.accountRefunds >= 0 && totals.accountRefunds <= 1000000000;
    }

    function validStudent(student, studentId) {
      return exactMap(student, [
          'studentId', 'studentCode', 'displayName', 'aliases', 'status', 'openingBalance', 'currentBalance',
          'createdAt', 'revision', 'lastCommandId', 'updatedAt'
        ])
        && student.studentId == studentId
        && validStudentId(studentId)
        && validStudentCode(student.studentCode)
        && validDisplayName(student.displayName)
        && student.aliases is list && validAliases(student.aliases)
        && student.status in ['active', 'inactive']
        && exactMap(student.openingBalance, ['amount', 'asOfDate', 'note', 'createdAt'])
        && student.openingBalance.amount is int
        && student.openingBalance.amount >= -1000000000 && student.openingBalance.amount <= 1000000000
        && student.openingBalance.asOfDate is string && validCalendarDate(student.openingBalance.asOfDate)
        && student.openingBalance.note is string
        && student.openingBalance.note.size() <= 500
        && student.openingBalance.createdAt is timestamp
        && student.currentBalance is int
        && student.currentBalance >= -1000000000 && student.currentBalance <= 1000000000
        && student.createdAt is timestamp
        && student.revision is int && student.revision >= 1
        && student.lastCommandId is string
        && student.updatedAt is timestamp;
    }

    function validMenu(menu, dayId) {
      return menu is map && menu.size() == 8
        && menu.businessDate == dayId
        && menu.itemName is string && menu.itemName.size() >= 1 && menu.itemName.size() <= 100
        && menu.price is int && menu.price >= 1 && menu.price <= 1000000
        && validId(menu.vendorId)
        && menu.vendorNameSnapshot is string && menu.vendorNameSnapshot.size() >= 1 && menu.vendorNameSnapshot.size() <= 100
        && menu.updatedAt is timestamp
        && menu.revision is int && menu.revision >= 1
        && (menu.inheritedFromDate == null || (menu.inheritedFromDate is string && validCalendarDate(menu.inheritedFromDate)));
    }

    function validVendor(vendor, vendorId) {
      return vendor is map && vendor.size() == 10
        && validId(vendorId)
        && vendor.vendorId == vendorId
        && validDisplayName(vendor.name)
        && vendor.phone is string && vendor.phone.size() <= 100
        && vendor.note is string && vendor.note.size() <= 500
        && vendor.status in ['active', 'inactive']
        && vendor.deleted is bool
        && vendor.createdAt is timestamp
        && vendor.revision is int && vendor.revision >= 1
        && vendor.lastCommandId is string
        && vendor.updatedAt is timestamp;
    }

    function validDay(day, dayId) {
      return day is map && day.size() == 10
        && day.status in ['open', 'closed', 'reopened']
        && day.revision is int && day.revision >= 1
        && (day.menu == null || validMenu(day.menu, dayId))
        && (day.openingCash == null || (day.openingCash is int && day.openingCash >= 0 && day.openingCash <= 20000))
        && (day.openingCash == null
          ? day.openedBy == null && day.openedAt == null
          : day.openedBy is string && day.openedBy.size() > 0 && day.openedAt is timestamp)
        && validTotals(day.totals)
        && day.lastSettlementRevision is int && day.lastSettlementRevision >= 0
        && day.lastCommandId is string
        && day.updatedAt is timestamp;
    }

    function validDayNonMenu(day) {
      return exactMap(day, [
          'status', 'revision', 'menu', 'openingCash', 'openedBy', 'openedAt',
          'totals', 'lastSettlementRevision', 'lastCommandId', 'updatedAt'
        ])
        && day.status in ['open', 'closed', 'reopened']
        && day.revision is int && day.revision >= 1
        && (day.openingCash == null || (day.openingCash is int && day.openingCash >= 0 && day.openingCash <= 20000))
        && (day.openingCash == null
          ? day.openedBy == null && day.openedAt == null
          : day.openedBy is string && day.openedBy.size() > 0 && day.openedAt is timestamp)
        && validTotals(day.totals)
        && day.lastSettlementRevision is int && day.lastSettlementRevision >= 0
        && day.lastCommandId is string
        && day.updatedAt is timestamp;
    }

    function validHeadAdvance(before, after, commandId) {
      return validHead(before)
        && before.maintenance == false
        && after.schemaVersion == before.schemaVersion
        && after.datasetId == before.datasetId
        && after.maintenance == before.maintenance
        && after.goLiveDate == before.goLiveDate
        && after.seq is int && after.seq >= 0 && after.seq > before.seq && after.seq == before.seq + 1
        && after.lastCommandId is string && after.lastCommandId == commandId
        && after.updatedAt is timestamp && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['seq', 'lastCommandId', 'updatedAt']);
    }

    function commandEnvelope(commandId, command, head, headAfter) {
      return exactMap(command, [
          'commandId', 'kind', 'seq', 'leaseEpoch', 'actor', 'committedAt', 'businessDate',
          'studentId', 'targets', 'expectedRevisions', 'before', 'after', 'reason',
          'cashEffect', 'payload', 'inputFingerprint'
        ])
        && validCommandId(commandId)
        && command.commandId == commandId
        && command.kind in [
          'EnsureDay', 'CreateOrder', 'CreatePayment', 'CreateStudent', 'ChangeStudentCode', 'EditStudent', 'SetStudentStatus',
          'SaveVendor', 'RemoveVendor', 'SetDayMenu', 'SetOpeningCash'
        ]
        && command.seq is int && command.seq == head.seq + 1
        && command.leaseEpoch is int && command.leaseEpoch >= 0
        && command.actor is map
        && exactMap(command.actor, ['uid', 'email'])
        && command.actor.uid == request.auth.uid
        && command.actor.email == request.auth.token.email
        && command.committedAt == request.time
        && (command.kind in ['SetStudentStatus', 'RemoveVendor', 'ChangeStudentCode']
          ? (command.reason is string && command.reason.size() >= 1 && command.reason.size() <= 500)
          : command.reason == null)
        && command.inputFingerprint is string
        && command.inputFingerprint.matches('^[0-9a-f]{64}$')
        && command.before is map && command.after is map
        && command.before.head == head
        && command.after.head == headAfter
        // The dataHead writer validates the complete fixed schema and diff.
        // Keep the command-side linkage cheap while still requiring a real advance.
        && head.maintenance == false
        && head.seq is int
        && headAfter.seq == head.seq + 1
        && headAfter.lastCommandId == commandId
        && headAfter.updatedAt == request.time
        && headAfter.schemaVersion == head.schemaVersion
        && headAfter.datasetId == head.datasetId
        && headAfter.maintenance == false
        && headAfter.goLiveDate == head.goLiveDate;
    }

    function p07CommandEnvelope(commandId, command, head, headAfter) {
      return exactMap(command, [
          'commandId', 'kind', 'seq', 'leaseEpoch', 'actor', 'committedAt', 'businessDate',
          'studentId', 'targets', 'expectedRevisions', 'before', 'after', 'reason',
          'cashEffect', 'payload', 'inputFingerprint'
        ])
        && validCommandId(commandId)
        && command.commandId == commandId
        && command.seq is int && command.seq == head.seq + 1
        && command.leaseEpoch is int && command.leaseEpoch >= 0
        && command.actor == {'uid': request.auth.uid, 'email': request.auth.token.email}
        && command.committedAt == request.time
        && (command.kind == 'RemoveVendor'
          ? (command.reason is string && command.reason.size() >= 1 && command.reason.size() <= 500)
          : command.reason == null)
        && command.inputFingerprint is string
        && command.inputFingerprint.matches('^[0-9a-f]{64}$')
        && head.maintenance == false
        && head.seq is int
        && headAfter.seq == head.seq + 1
        && headAfter.lastCommandId == commandId
        && headAfter.updatedAt == request.time;
    }

    function validCashEffect(effect, amount) {
      return exactMap(effect, ['before', 'after', 'delta', 'reasonKind', 'refundAmount'])
        && effect.before == 0
        && effect.after == amount
        && effect.delta == amount
        && effect.reasonKind == (amount > 0 ? 'collection' : 'none')
        && effect.refundAmount == 0;
    }

    function zeroCashEffect(effect) {
      return effect == {'before': 0, 'after': 0, 'delta': 0, 'reasonKind': 'none', 'refundAmount': 0};
    }

    function validNewDay(dayId, day, commandId) {
      let totals = day.totals;
      return exactMap(day, [
          'status', 'revision', 'menu', 'openingCash', 'openedBy', 'openedAt',
          'totals', 'lastSettlementRevision', 'lastCommandId', 'updatedAt'
        ])
        && validCalendarDate(dayId)
        && day.status == 'open'
        && day.revision == 1
        && day.menu == null
        && day.openingCash == null
        && day.openedBy == null
        && day.openedAt == null
        && exactMap(totals, [
          'activeTransactionCount', 'bentoCount', 'otherMealCount', 'mealTotal',
          'retainedReceipts', 'cashierIncome', 'cashierExpense', 'accountRefunds'
        ])
        && totals.activeTransactionCount == 0
        && totals.bentoCount == 0
        && totals.otherMealCount == 0
        && totals.mealTotal == 0
        && totals.retainedReceipts == 0
        && totals.cashierIncome == 0
        && totals.cashierExpense == 0
        && totals.accountRefunds == 0
        && day.lastSettlementRevision == 0
        && day.lastCommandId == commandId
        && day.updatedAt == request.time;
    }

    function validStudentOpeningDate(date, goLiveDate) {
      return validTaipeiDate(date)
        && date >= goLiveDate
        && (date == goLiveDate || validCurrentTaipeiDate(date));
    }

    function validStudentCashEffect(effect) {
      return exactMap(effect, ['before', 'after', 'delta', 'reasonKind', 'refundAmount'])
        && effect.before == 0
        && effect.after == 0
        && effect.delta == 0
        && effect.reasonKind == 'none'
        && effect.refundAmount == 0;
    }

    function validCreateStudent(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let studentId = command.targets.studentId;
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(studentId)).data;
      let opening = command.payload.openingBalance;
      let code = command.payload.studentCode;
      let codeIndexAfter = getAfter(/databases/$(database)/documents/studentCodes/$(code)).data;
      return commandHolder(command.leaseEpoch)
        && commandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'CreateStudent'
        && exactMap(command.targets, ['studentId'])
        && validStudentId(studentId)
        && exactMap(command.expectedRevisions, ['student'])
        && command.expectedRevisions.student == 0
        && exactMap(command.payload, ['studentCode', 'displayName', 'aliases', 'openingBalance'])
        && validStudentCode(code)
        && exactMap(opening, ['amount', 'asOfDate', 'note'])
        && opening.amount is int
        && opening.amount >= -1000000000 && opening.amount <= 1000000000
        && validStudentOpeningDate(opening.asOfDate, head.goLiveDate)
        && opening.note is string && opening.note.size() <= 500
        && exactMap(command.before, ['head', 'student'])
        && exactMap(command.after, ['head', 'student'])
        && command.before.head == head
        && command.after.head == headAfter
        && !exists(/databases/$(database)/documents/students/$(studentId))
        && command.before.student == null
        && command.after.student == studentAfter
        && command.studentId == studentId
        && command.businessDate == null
        && command.reason == null
        && studentAfter is map
        && studentAfter.studentId == studentId
        && studentAfter.studentCode == code
        && studentAfter.displayName == command.payload.displayName
        && studentAfter.aliases == command.payload.aliases
        && studentAfter.status == 'active'
        && studentAfter.openingBalance.amount == opening.amount
        && studentAfter.openingBalance.asOfDate == opening.asOfDate
        && studentAfter.openingBalance.note == opening.note
        && studentAfter.currentBalance == opening.amount
        && studentAfter.createdAt == request.time
        && studentAfter.openingBalance.createdAt == request.time
        && studentAfter.revision == 1
        && studentAfter.lastCommandId == commandId
        && studentAfter.updatedAt == request.time
        && !exists(/databases/$(database)/documents/studentCodes/$(code))
        && codeIndexAfter is map
        && codeIndexAfter.studentId == studentId
        && codeIndexAfter.lastCommandId == commandId
        && codeIndexAfter.updatedAt == request.time
        && validStudentCashEffect(command.cashEffect);
    }

    function validChangeStudentCode(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let studentId = command.targets.studentId;
      let studentBefore = get(/databases/$(database)/documents/students/$(studentId)).data;
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(studentId)).data;
      let newCode = command.payload.studentCode;
      let oldCode = studentBefore.studentCode;
      let newIndexAfter = getAfter(/databases/$(database)/documents/studentCodes/$(newCode)).data;
      let oldIndexBefore = get(/databases/$(database)/documents/studentCodes/$(oldCode)).data;
      return commandHolder(command.leaseEpoch)
        && commandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'ChangeStudentCode'
        && exactMap(command.targets, ['studentId'])
        && validStudentId(studentId)
        && exactMap(command.expectedRevisions, ['student'])
        && command.expectedRevisions.student is int
        && command.expectedRevisions.student >= 1
        && exactMap(command.payload, ['studentCode', 'reason'])
        && validStudentCode(newCode)
        && command.payload.reason is string && command.payload.reason.size() >= 1 && command.payload.reason.size() <= 500
        && exactMap(command.before, ['head', 'student'])
        && exactMap(command.after, ['head', 'student'])
        && command.before.head == head
        && command.after.head == headAfter
        && command.before.student == studentBefore
        && command.after.student == studentAfter
        && command.studentId == studentId
        && command.businessDate == null
        && command.reason == command.payload.reason
        && studentBefore.revision == command.expectedRevisions.student
        && studentAfter.revision == studentBefore.revision + 1
        && studentBefore.studentCode != newCode
        && studentAfter.studentCode == newCode
        && studentAfter.lastCommandId == commandId
        && studentAfter.updatedAt == request.time
        && studentAfter.diff(studentBefore).affectedKeys().hasOnly(['studentCode', 'revision', 'lastCommandId', 'updatedAt'])
        && !exists(/databases/$(database)/documents/studentCodes/$(newCode))
        && newIndexAfter is map
        && newIndexAfter.studentId == studentId
        && newIndexAfter.lastCommandId == commandId
        && newIndexAfter.updatedAt == request.time
        && oldIndexBefore is map
        && oldIndexBefore.studentId == studentId
        && !existsAfter(/databases/$(database)/documents/studentCodes/$(oldCode))
        && validStudentCashEffect(command.cashEffect);
    }

    function validStudentEditShape(commandId, command) {
      let before = command.before.student;
      let after = command.after.student;
      let payload = command.payload;
      return exactMap(command.targets, ['studentId'])
        && validStudentId(command.targets.studentId)
        && exactMap(command.expectedRevisions, ['student'])
        && command.expectedRevisions.student is int
        && command.expectedRevisions.student >= 1
        && payload is map && payload.keys().hasOnly(['displayName', 'aliases'])
        && payload.keys().hasAny(['displayName', 'aliases'])
        && before is map && after is map
        && before.studentId == command.targets.studentId
        && after.studentId == command.targets.studentId
        && before.revision == command.expectedRevisions.student
        && after.revision == before.revision + 1
        && after.lastCommandId == commandId
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['displayName', 'aliases', 'revision', 'lastCommandId', 'updatedAt'])
        && (!('displayName' in payload) || after.displayName == payload.displayName)
        && ('displayName' in payload || before.displayName == after.displayName)
        && (!('aliases' in payload) || after.aliases == payload.aliases)
        && ('aliases' in payload || before.aliases == after.aliases)
        && (before.displayName != after.displayName || before.aliases != after.aliases)
        && command.reason == null;
    }

    function validStudentStatusShape(commandId, command) {
      let before = command.before.student;
      let after = command.after.student;
      let payload = command.payload;
      return exactMap(command.targets, ['studentId'])
        && validStudentId(command.targets.studentId)
        && exactMap(command.expectedRevisions, ['student'])
        && command.expectedRevisions.student is int
        && command.expectedRevisions.student >= 1
        && exactMap(payload, ['status', 'reason'])
        && payload.status in ['active', 'inactive']
        && payload.reason is string && payload.reason.size() >= 1 && payload.reason.size() <= 500
        && before is map && after is map
        && before.studentId == command.targets.studentId
        && after.studentId == command.targets.studentId
        && before.revision == command.expectedRevisions.student
        && after.revision == before.revision + 1
        && after.status == payload.status
        && before.status != after.status
        && after.lastCommandId == commandId
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['status', 'revision', 'lastCommandId', 'updatedAt'])
        && command.reason == payload.reason;
    }

    function validStudentMutation(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let studentBefore = get(/databases/$(database)/documents/students/$(command.targets.studentId)).data;
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(command.targets.studentId)).data;
      return commandHolder(command.leaseEpoch)
        && commandEnvelope(commandId, command, head, headAfter)
        && command.kind in ['EditStudent', 'SetStudentStatus']
        && exactMap(command.before, ['head', 'student'])
        && exactMap(command.after, ['head', 'student'])
        && command.before.head == head
        && command.after.head == headAfter
        && command.before.student == studentBefore
        && command.after.student == studentAfter
        && command.studentId == command.targets.studentId
        && command.businessDate == null
        && validStudentCashEffect(command.cashEffect)
        && (command.kind == 'EditStudent'
          ? validStudentEditShape(commandId, command)
          : validStudentStatusShape(commandId, command));
    }

    function validEnsureDay(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayId = command.targets.dayId;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      return commandHolder(command.leaseEpoch)
        && commandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'EnsureDay'
        && exactMap(command.targets, ['dayId'])
        && command.targets.dayId is string
        && exactMap(command.expectedRevisions, ['day'])
        && command.expectedRevisions.day == 0
        && exactMap(command.payload, ['businessDate'])
        && command.payload.businessDate == dayId
        && command.businessDate == dayId
        && command.studentId == null
        && exactMap(command.before, ['head', 'day'])
        && exactMap(command.after, ['head', 'day'])
        && command.before.day == null
        && command.after.day == dayAfter
        && !exists(/databases/$(database)/documents/days/$(dayId))
        && dayAfter.lastCommandId == commandId
        && validNewDay(dayId, dayAfter, commandId)
        && dayId >= head.goLiveDate
        && validCashEffect(command.cashEffect, 0);
    }

    function validSaveVendorCommon(commandId, command, head, headAfter, vendorBefore, vendorAfter, createVendor) {
      let vendorId = command.targets.vendorId;
      return commandHolder(command.leaseEpoch)
        && p07CommandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'SaveVendor'
        && exactMap(command.targets, ['vendorId'])
        && validId(vendorId)
        && exactMap(command.expectedRevisions, ['vendor'])
        && exactMap(command.payload, ['vendorId', 'name', 'phone', 'note', 'status'])
        && command.payload.vendorId == vendorId
        && command.businessDate == null
        && command.studentId == null
        && command.reason == null
        && zeroCashEffect(command.cashEffect)
        && exactMap(command.before, ['head', 'vendor'])
        && exactMap(command.after, ['head', 'vendor'])
        && command.before.head == head
        && command.after.head == headAfter
        && (createVendor
          ? command.expectedRevisions.vendor == 0 && vendorBefore == null
            && command.before.vendor == null
            && vendorAfter is map
            && vendorAfter.vendorId == vendorId
            && vendorAfter.name == command.payload.name
            && vendorAfter.phone == command.payload.phone
            && vendorAfter.note == command.payload.note
            && vendorAfter.status == command.payload.status
            && command.payload.status == 'active'
            && vendorAfter.deleted == false
            && vendorAfter.revision == 1
            && vendorAfter.lastCommandId == commandId
            && vendorAfter.createdAt == request.time
            && vendorAfter.updatedAt == request.time
          : vendorBefore.deleted == false
            && command.expectedRevisions.vendor == vendorBefore.revision
            && vendorAfter is map
            && vendorAfter.vendorId == vendorId
            && vendorAfter.name == command.payload.name
            && vendorAfter.phone == command.payload.phone
            && vendorAfter.note == command.payload.note
            && vendorAfter.status == command.payload.status
            && vendorAfter.deleted == false
            && vendorAfter.revision == vendorBefore.revision + 1
            && vendorAfter.lastCommandId == commandId
            && vendorAfter.createdAt == vendorBefore.createdAt
            && vendorAfter.updatedAt == request.time);
    }

    function validSaveVendorCreate(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let vendorId = command.targets.vendorId;
      let vendorAfter = getAfter(/databases/$(database)/documents/vendors/$(vendorId)).data;
      return validSaveVendorCommon(commandId, command, head, headAfter, null, vendorAfter, true)
        && !exists(/databases/$(database)/documents/vendors/$(vendorId));
    }

    function validSaveVendorUpdate(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let vendorId = command.targets.vendorId;
      let vendorBefore = get(/databases/$(database)/documents/vendors/$(vendorId)).data;
      let vendorAfter = getAfter(/databases/$(database)/documents/vendors/$(vendorId)).data;
      return validSaveVendorCommon(commandId, command, head, headAfter, vendorBefore, vendorAfter, false);
    }

    function validSaveVendor(commandId, command) {
      return command.kind == 'SaveVendor'
        && exactMap(command.expectedRevisions, ['vendor'])
        && (command.expectedRevisions.vendor == 0
          ? validSaveVendorCreate(commandId, command)
          : validSaveVendorUpdate(commandId, command));
    }

    function validRemoveVendor(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let vendorId = command.targets.vendorId;
      let vendorBefore = get(/databases/$(database)/documents/vendors/$(vendorId)).data;
      let vendorAfter = getAfter(/databases/$(database)/documents/vendors/$(vendorId)).data;
      return commandHolder(command.leaseEpoch)
        && p07CommandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'RemoveVendor'
        && exactMap(command.targets, ['vendorId'])
        && validId(vendorId)
        && exactMap(command.expectedRevisions, ['vendor'])
        && exactMap(command.payload, ['reason'])
        && command.payload.reason is string
        && command.payload.reason.size() >= 1 && command.payload.reason.size() <= 500
        && command.businessDate == null
        && command.studentId == null
        && command.reason == command.payload.reason
        && zeroCashEffect(command.cashEffect)
        && exactMap(command.before, ['head', 'vendor'])
        && exactMap(command.after, ['head', 'vendor'])
        && command.before.head == head
        && command.after.head == headAfter
        && vendorBefore.status == 'inactive'
        && vendorBefore.deleted == false
        && command.expectedRevisions.vendor == vendorBefore.revision
        && vendorAfter.name == vendorBefore.name
        && vendorAfter.phone == vendorBefore.phone
        && vendorAfter.note == vendorBefore.note
        && vendorAfter.status == 'inactive'
        && vendorAfter.deleted == true
        && vendorAfter.createdAt == vendorBefore.createdAt
        && vendorAfter.revision == vendorBefore.revision + 1
        && vendorAfter.lastCommandId == commandId
        && vendorAfter.updatedAt == request.time;
    }

    function validSetDayMenuCommon(commandId, command, head, headAfter, dayBefore, dayAfter) {
      let dayId = command.targets.dayId;
      let payload = command.payload;
      return commandHolder(command.leaseEpoch)
        && p07CommandEnvelope(commandId, command, head, headAfter)
        && exactMap(command.targets, ['dayId'])
        && validCalendarDate(dayId)
        && exactMap(command.expectedRevisions, ['day', 'headSeq'])
        && exactMap(payload, ['selectionDate', 'itemName', 'price', 'vendorId', 'vendorNameSnapshot', 'inheritedFromDate'])
        && payload.price is int
        && validCurrentTaipeiDate(payload.selectionDate)
        && dayBefore.revision is int && dayBefore.revision >= 1
        && command.expectedRevisions.day == dayBefore.revision
        && command.expectedRevisions.headSeq == head.seq
        && command.businessDate == dayId
        && command.studentId == null
        && command.reason == null
        && zeroCashEffect(command.cashEffect)
        && command.before == {'head': head, 'day': command.before.day}
        && command.after == {'head': headAfter, 'day': command.after.day}
        && dayId >= head.goLiveDate
        && dayBefore.status in ['open', 'reopened']
        && dayAfter.revision > dayBefore.revision
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId
        && dayAfter.updatedAt == request.time;
    }

    function validSetDayMenuDirect(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayId = command.targets.dayId;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      let menuAfter = dayAfter.menu;
      let vendor = get(/databases/$(database)/documents/vendors/$(command.payload.vendorId)).data;
      return command.payload.inheritedFromDate == null
        && validSetDayMenuCommon(commandId, command, head, headAfter, dayBefore, dayAfter)
        && validVendor(vendor, command.payload.vendorId)
        && vendor.status == 'active'
        && vendor.deleted == false
        && command.payload.vendorNameSnapshot == vendor.name
        && menuAfter.itemName == command.payload.itemName
        && menuAfter.price == command.payload.price
        && menuAfter.vendorId == command.payload.vendorId
        && menuAfter.vendorNameSnapshot == command.payload.vendorNameSnapshot
        && menuAfter.inheritedFromDate == null
        && menuAfter.businessDate == dayId
        && menuAfter.revision == (dayBefore.menu == null ? 1 : dayBefore.menu.revision + 1)
        && menuAfter.updatedAt == request.time;
    }

    function validSetDayMenuInherited(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayId = command.targets.dayId;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      let sourceDate = command.payload.inheritedFromDate;
      return validCalendarDate(sourceDate)
        && sourceDate < dayId
        && sourceDate <= command.payload.selectionDate
        && validSetDayMenuCommon(commandId, command, head, headAfter, dayBefore, dayAfter);
    }

    function validSetDayMenuInheritedBusiness(command, dayId, dayBefore, dayAfter) {
      let sourceDate = command.payload.inheritedFromDate;
      let sourceDay = get(/databases/$(database)/documents/days/$(sourceDate)).data;
      let sourceMenu = sourceDay.menu;
      let vendor = get(/databases/$(database)/documents/vendors/$(command.payload.vendorId)).data;
      // validDay(sourceDay, sourceDate) runs in headCommand on the same atomic commit's
      // mandatory dataHead write; the per-document expression ceiling cannot hold both here.
      return sourceMenu is map
        && command.payload.itemName == sourceMenu.itemName
        && command.payload.price == sourceMenu.price
        && command.payload.vendorId == sourceMenu.vendorId
        && command.payload.vendorNameSnapshot == sourceMenu.vendorNameSnapshot
        && validVendor(vendor, command.payload.vendorId)
        && vendor.status == 'active'
        && vendor.deleted == false
        && command.payload.vendorNameSnapshot == vendor.name
        && dayAfter.menu == {
          'businessDate': dayId,
          'itemName': sourceMenu.itemName,
          'price': sourceMenu.price,
          'vendorId': sourceMenu.vendorId,
          'vendorNameSnapshot': sourceMenu.vendorNameSnapshot,
          'updatedAt': request.time,
          'revision': dayBefore.menu == null ? 1 : dayBefore.menu.revision + 1,
          'inheritedFromDate': sourceDate
        }
        && dayAfter.menu.price is int
        && dayAfter.menu.revision is int && dayAfter.menu.revision >= 1;
    }

    function validSetDayMenu(commandId, command) {
      return command.payload.inheritedFromDate == null
        ? validSetDayMenuDirect(commandId, command)
        : validSetDayMenuInherited(commandId, command);
    }

    // The optional payload reason (the opening differs from the last close, contract §11) means this kind
    // cannot use p07CommandEnvelope, which fixes the command reason to null for everything but RemoveVendor.
    // cashCommandEnvelope is the same envelope without that reason check; the reason is bound below.
    function validSetOpeningCash(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayId = command.targets.dayId;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      return commandHolder(command.leaseEpoch)
        && cashCommandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'SetOpeningCash'
        && exactMap(command.targets, ['dayId'])
        && exactMap(command.expectedRevisions, ['day'])
        && dayBefore.revision is int && dayBefore.revision >= 1
        && command.expectedRevisions.day == dayBefore.revision
        && ((exactMap(command.payload, ['openingCash']) && command.reason == null)
          || (exactMap(command.payload, ['openingCash', 'reason'])
            && validMutationReason(command.payload.reason)
            && command.reason == command.payload.reason))
        && command.payload.openingCash is int
        && command.payload.openingCash >= 0 && command.payload.openingCash <= 20000
        && validCurrentTaipeiDate(dayId)
        && dayId >= head.goLiveDate
        && command.businessDate == dayId
        && command.studentId == null
        && zeroCashEffect(command.cashEffect)
        && exactMap(command.before, ['head', 'day'])
        && exactMap(command.after, ['head', 'day'])
        && command.before.head == head
        && command.after.head == headAfter
        && dayAfter.openingCash is int
        && dayAfter.openingCash == command.payload.openingCash
        && dayAfter.lastCommandId == commandId
        && dayAfter.revision is int
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.updatedAt == request.time;
    }

    function validTransactionDoc(tx, commandId, command, seq, head, dayBefore, studentBefore) {
      let order = command.kind == 'CreateOrder';
      let bento = order && command.payload.mealKind == 'bento';
      let menu = dayBefore.menu;
      return exactMap(tx, [
          'transactionId', 'studentId', 'businessDate', 'type', 'mealKind', 'mealPrice', 'paidAmount',
          'amount', 'studentNameSnapshot', 'menuNameSnapshot', 'menuPriceSnapshot', 'vendorIdSnapshot',
          'vendorNameSnapshot', 'otherItemName', 'status', 'revision', 'createdAt', 'createdSeq',
          'operatorUid', 'operatorEmail', 'sourceDevice', 'note', 'lastCommandId', 'updatedAt'
        ])
        && tx.transactionId == command.targets.transactionId
        && tx.studentId == command.targets.studentId
        && tx.businessDate == command.targets.dayId
        && tx.businessDate >= head.goLiveDate
        && validCurrentTaipeiDate(tx.businessDate)
        && tx.type == (order ? 'order' : 'payment')
        && tx.mealKind == (order ? command.payload.mealKind : null)
        && tx.mealPrice == (order ? command.payload.mealPrice : 0)
        && tx.mealPrice is int && tx.mealPrice >= 0 && tx.mealPrice <= 1000000
        && tx.paidAmount == command.payload.paidAmount
        && tx.paidAmount is int && tx.paidAmount >= (order ? 0 : 1) && tx.paidAmount <= 1000000
        && tx.amount == tx.paidAmount - tx.mealPrice
        && tx.amount is int && tx.amount >= -1000000 && tx.amount <= 1000000
        && tx.studentNameSnapshot == studentBefore.displayName
        && tx.menuNameSnapshot == (bento ? menu.itemName : '')
        && tx.menuPriceSnapshot == (bento ? menu.price : 0)
        && tx.vendorIdSnapshot == (bento ? menu.vendorId : '')
        && tx.vendorNameSnapshot == (bento ? menu.vendorNameSnapshot : '')
        && tx.otherItemName == (order && command.payload.mealKind == 'other' ? command.payload.otherItemName : null)
        && tx.status == 'active'
        && tx.revision == 1
        && tx.createdAt == request.time
        && tx.createdSeq == seq
        && tx.operatorUid == request.auth.uid
        && tx.operatorEmail == request.auth.token.email
        && tx.sourceDevice == 'pc'
        && tx.note == command.payload.note
        && tx.lastCommandId == commandId
        && tx.updatedAt == request.time;
    }

    function validTransactionCommand(commandId, command, head, headAfter, dayBefore, studentBefore) {
      return commandHolder(command.leaseEpoch)
        && commandEnvelope(commandId, command, head, headAfter)
        && command.kind in ['CreateOrder', 'CreatePayment']
        && exactMap(command.targets, ['transactionId', 'studentId', 'dayId'])
        && validId(command.targets.transactionId)
        && validId(command.targets.studentId)
        && command.targets.studentId != '__cashier__'
        && validCalendarDate(command.targets.dayId)
        && exactMap(command.expectedRevisions, ['transaction', 'student', 'day'])
        && command.expectedRevisions.transaction == 0
        && command.expectedRevisions.student == studentBefore.revision
        && command.expectedRevisions.day == dayBefore.revision
        && exactMap(command.before, ['head', 'student', 'day', 'transaction'])
        && exactMap(command.after, ['head', 'student', 'day', 'transaction'])
        && command.before.head == head
        && command.before.student == studentBefore
        && command.before.day == dayBefore
        && command.before.transaction == null
        && command.targets.dayId >= head.goLiveDate
        && command.businessDate == command.targets.dayId
        && command.studentId == command.targets.studentId;
    }

    function validReceiptTransaction(commandId, command, transactionAfter) {
      return command.after.transaction == transactionAfter
        && transactionAfter.transactionId == command.targets.transactionId
        && transactionAfter.lastCommandId == commandId;
    }

    function validStudentAdvance(commandId, command, studentBefore, studentAfter, mealPrice) {
      return command.after.student == studentAfter
        && validStudent(studentAfter, command.targets.studentId)
        && (command.kind == 'CreatePayment' || studentBefore.status == 'active')
        && studentBefore.openingBalance.asOfDate <= command.targets.dayId
        && studentAfter.diff(studentBefore).affectedKeys().hasOnly(['currentBalance', 'revision', 'lastCommandId', 'updatedAt'])
        && studentAfter.currentBalance is int
        && studentAfter.currentBalance == studentBefore.currentBalance + command.payload.paidAmount - mealPrice
        && studentAfter.currentBalance >= -1000000000 && studentAfter.currentBalance <= 1000000000
        && studentAfter.revision is int
        && studentAfter.revision == studentBefore.revision + 1
        && studentAfter.lastCommandId == commandId
        && studentAfter.updatedAt == request.time;
    }

    function validDayAdvance(commandId, command, dayBefore, dayAfter, mealPrice, order) {
      let beforeTotals = dayBefore.totals;
      let afterTotals = dayAfter.totals;
      return command.after.day == dayAfter
        && validDay(dayAfter, command.targets.dayId)
        && validTotals(beforeTotals)
        && dayBefore.status in ['open', 'reopened']
        && dayAfter.diff(dayBefore).affectedKeys().hasOnly(['revision', 'totals', 'lastCommandId', 'updatedAt'])
        && dayAfter.revision is int
        && dayAfter.revision == dayBefore.revision + 1
        // One whole-map equality: exactly these eight keys, each with its advanced or unchanged value
        // (same meaning as exactMap plus per-key equalities, in fewer expressions).
        && afterTotals == {
          'activeTransactionCount': beforeTotals.activeTransactionCount + 1,
          'bentoCount': beforeTotals.bentoCount + (order && command.payload.mealKind == 'bento' ? 1 : 0),
          'otherMealCount': beforeTotals.otherMealCount + (order && command.payload.mealKind == 'other' ? 1 : 0),
          'mealTotal': beforeTotals.mealTotal + mealPrice,
          'retainedReceipts': beforeTotals.retainedReceipts + command.payload.paidAmount,
          'cashierIncome': beforeTotals.cashierIncome,
          'cashierExpense': beforeTotals.cashierExpense,
          'accountRefunds': beforeTotals.accountRefunds
        }
        && afterTotals.activeTransactionCount is int && afterTotals.activeTransactionCount >= 0 && afterTotals.activeTransactionCount <= 1000000000
        && afterTotals.bentoCount is int && afterTotals.bentoCount >= 0 && afterTotals.bentoCount <= 1000000000
        && afterTotals.otherMealCount is int && afterTotals.otherMealCount >= 0 && afterTotals.otherMealCount <= 1000000000
        && afterTotals.mealTotal is int && afterTotals.mealTotal >= 0 && afterTotals.mealTotal <= 1000000000
        && afterTotals.retainedReceipts is int && afterTotals.retainedReceipts >= 0 && afterTotals.retainedReceipts <= 1000000000
        && dayAfter.status == dayBefore.status
        && dayAfter.menu == dayBefore.menu
        && dayAfter.openingCash == dayBefore.openingCash
        && dayAfter.openedBy == dayBefore.openedBy
        && dayAfter.openedAt == dayBefore.openedAt
        && dayAfter.lastSettlementRevision == dayBefore.lastSettlementRevision
        && dayAfter.lastCommandId == commandId
        && dayAfter.updatedAt == request.time;
    }

    function validTransactionPayload(commandId, command, head, dayBefore, studentBefore, transactionAfter) {
      let order = command.kind == 'CreateOrder';
      let mealPrice = order ? command.payload.mealPrice : 0;
      return (order
          ? exactMap(command.payload, ['mealPrice', 'paidAmount', 'mealKind', 'menuRevision', 'otherItemName', 'note'])
            && command.payload.mealPrice is int && command.payload.mealPrice >= 0 && command.payload.mealPrice <= 1000000
            && command.payload.paidAmount is int && command.payload.paidAmount >= 0 && command.payload.paidAmount <= 1000000
            && command.payload.mealKind in ['bento', 'other']
            && command.payload.note is string && command.payload.note.size() <= 500
            && (command.payload.mealKind == 'bento'
              ? validMenu(dayBefore.menu, command.targets.dayId)
                && command.payload.menuRevision == dayBefore.menu.revision
                && command.payload.mealPrice == dayBefore.menu.price
                && command.payload.otherItemName == null
              : command.payload.menuRevision == null
                && command.payload.otherItemName is string
                && command.payload.otherItemName.size() >= 1
                && command.payload.otherItemName.size() <= 100)
          : exactMap(command.payload, ['paidAmount', 'note'])
            && command.payload.paidAmount is int && command.payload.paidAmount > 0 && command.payload.paidAmount <= 1000000
            && command.payload.note is string && command.payload.note.size() <= 500)
        && validTransactionDoc(transactionAfter, commandId, command, head.seq + 1, head, dayBefore, studentBefore)
        && validReceiptTransaction(commandId, command, transactionAfter)
        && validCashEffect(command.cashEffect, command.payload.paidAmount)
        && (command.kind == 'CreatePayment' || studentBefore.status == 'active')
        && studentBefore.openingBalance.asOfDate <= command.targets.dayId
        && dayBefore.status in ['open', 'reopened']
        && command.targets.dayId >= head.goLiveDate
        && validCurrentTaipeiDate(command.targets.dayId)
        && (order || mealPrice == 0);
    }

    function validCreateTransaction(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayBefore = get(/databases/$(database)/documents/days/$(command.targets.dayId)).data;
      let studentBefore = get(/databases/$(database)/documents/students/$(command.targets.studentId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(command.targets.dayId)).data;
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(command.targets.studentId)).data;
      let transactionAfter = getAfter(/databases/$(database)/documents/transactions/$(command.targets.transactionId)).data;
      let transactionExists = exists(/databases/$(database)/documents/transactions/$(command.targets.transactionId));
      let order = command.kind == 'CreateOrder';
      return validTransactionCommand(commandId, command, head, headAfter, dayBefore, studentBefore)
        && !transactionExists
        && command.before.transaction == null
        && command.after.student == studentAfter
        && studentAfter.revision == studentBefore.revision + 1
        && studentAfter.lastCommandId == commandId
        && studentAfter.updatedAt == request.time
        && command.after.day == dayAfter
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId
        && dayAfter.updatedAt == request.time
        && command.after.transaction == transactionAfter
        && transactionAfter.createdAt == request.time
        && transactionAfter.createdSeq == head.seq + 1
        && transactionAfter.lastCommandId == commandId
        && transactionAfter.operatorUid == request.auth.uid
        && transactionAfter.operatorEmail == request.auth.token.email;
    }

    // P09a CreateCashMovement: the counter's own cash income or expense, never a student row.
    // Income is mealPrice 0 / paidAmount > 0, expense the reverse (spec §6.1); exactly one side is positive.
    function validCashMovementPayload(payload) {
      return exactMap(payload, ['mealPrice', 'paidAmount', 'reason'])
        && payload.mealPrice is int && payload.mealPrice >= 0 && payload.mealPrice <= 1000000
        && payload.paidAmount is int && payload.paidAmount >= 0 && payload.paidAmount <= 1000000
        && ((payload.mealPrice == 0 && payload.paidAmount > 0) || (payload.paidAmount == 0 && payload.mealPrice > 0))
        && payload.reason is string && payload.reason.size() >= 1 && payload.reason.size() <= 500;
    }

    function validCashMovementEffect(effect, payload) {
      return effect == (payload.paidAmount > 0
        ? {'before': 0, 'after': payload.paidAmount, 'delta': payload.paidAmount, 'reasonKind': 'collection', 'refundAmount': 0}
        : {'before': 0, 'after': -payload.mealPrice, 'delta': -payload.mealPrice, 'reasonKind': 'payout', 'refundAmount': 0});
    }

    function validCashMovementTransactionDoc(tx, commandId, command, seq) {
      // 與逐欄 exactMap＋等式相同語義：整份文件必須恰等於這 24 個欄位；用一次 map 比較以節省 expression。
      return tx == {
        'transactionId': command.targets.transactionId,
        'studentId': '__cashier__',
        'businessDate': command.targets.dayId,
        'type': 'expense',
        'mealKind': null,
        'mealPrice': command.payload.mealPrice,
        'paidAmount': command.payload.paidAmount,
        'amount': command.payload.paidAmount - command.payload.mealPrice,
        'studentNameSnapshot': '櫃台',
        'menuNameSnapshot': '',
        'menuPriceSnapshot': 0,
        'vendorIdSnapshot': '',
        'vendorNameSnapshot': '',
        'otherItemName': null,
        'status': 'active',
        'revision': 1,
        'createdAt': request.time,
        'createdSeq': seq,
        'operatorUid': request.auth.uid,
        'operatorEmail': request.auth.token.email,
        'sourceDevice': 'pc',
        'note': command.payload.reason,
        'lastCommandId': commandId,
        'updatedAt': request.time
      };
    }

    function cashCommandEnvelope(commandId, command, head, headAfter) {
      return exactMap(command, [
          'commandId', 'kind', 'seq', 'leaseEpoch', 'actor', 'committedAt', 'businessDate',
          'studentId', 'targets', 'expectedRevisions', 'before', 'after', 'reason',
          'cashEffect', 'payload', 'inputFingerprint'
        ])
        && validCommandId(commandId)
        && command.commandId == commandId
        && command.seq is int && command.seq == head.seq + 1
        && command.leaseEpoch is int && command.leaseEpoch >= 0
        && command.actor == {'uid': request.auth.uid, 'email': request.auth.token.email}
        && command.committedAt == request.time
        && command.inputFingerprint is string
        && command.inputFingerprint.matches('^[0-9a-f]{64}$')
        && head.maintenance == false
        && head.seq is int
        && headAfter.seq == head.seq + 1
        && headAfter.lastCommandId == commandId
        && headAfter.updatedAt == request.time;
    }

    function validCreateCashMovement(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayId = command.targets.dayId;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      let transactionAfter = getAfter(/databases/$(database)/documents/transactions/$(command.targets.transactionId)).data;
      return commandHolder(command.leaseEpoch)
        && cashCommandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'CreateCashMovement'
        && exactMap(command.targets, ['transactionId', 'dayId'])
        && validId(command.targets.transactionId)
        && validCalendarDate(dayId)
        && exactMap(command.expectedRevisions, ['transaction', 'day'])
        && command.expectedRevisions.transaction == 0
        && command.expectedRevisions.day == dayBefore.revision
        && validCashMovementPayload(command.payload)
        && command.reason == command.payload.reason
        && validCashMovementEffect(command.cashEffect, command.payload)
        && command.businessDate == dayId
        && command.studentId == '__cashier__'
        && command.before == {'head': head, 'day': dayBefore, 'transaction': null}
        && command.after == {'head': headAfter, 'day': dayAfter, 'transaction': transactionAfter}
        && !exists(/databases/$(database)/documents/transactions/$(command.targets.transactionId))
        && dayBefore.status in ['open', 'reopened']
        && dayId >= head.goLiveDate
        && validCurrentTaipeiDate(dayId)
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId
        && dayAfter.updatedAt == request.time
        && validCashMovementTransactionDoc(transactionAfter, commandId, command, head.seq + 1);
    }

    function validDayCashMovementProjection(commandId, command, dayId, before, after) {
      let beforeTotals = before.totals;
      let afterTotals = after.totals;
      return command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && validDay(after, dayId)
        && validTotals(beforeTotals)
        && before.status in ['open', 'reopened']
        && after.diff(before).affectedKeys().hasOnly(['revision', 'totals', 'lastCommandId', 'updatedAt'])
        && after.revision == before.revision + 1
        && afterTotals.activeTransactionCount == beforeTotals.activeTransactionCount + 1
        && afterTotals.bentoCount == beforeTotals.bentoCount
        && afterTotals.otherMealCount == beforeTotals.otherMealCount
        && afterTotals.mealTotal == beforeTotals.mealTotal
        && afterTotals.retainedReceipts == beforeTotals.retainedReceipts
        && afterTotals.cashierIncome == beforeTotals.cashierIncome + command.payload.paidAmount
        && afterTotals.cashierExpense == beforeTotals.cashierExpense + command.payload.mealPrice
        && afterTotals.accountRefunds == beforeTotals.accountRefunds
        && after.lastCommandId == commandId
        && after.updatedAt == request.time;
    }

    // P09b CreateRefund: pay a student's positive account balance back in cash (spec §7.1/§7.2).
    // The refund is a positive `amount` with mealPrice/paidAmount 0; balance and counter cash both fall by it.
    function validRefundPayload(payload) {
      return exactMap(payload, ['amount', 'reason'])
        && payload.amount is int && payload.amount >= 1 && payload.amount <= 1000000
        && payload.reason is string && payload.reason.size() >= 1 && payload.reason.size() <= 500;
    }

    function validRefundTransactionDoc(tx, commandId, command, seq, studentName) {
      // Whole-document equality: exactly these 24 keys and values (int and double are not equal).
      return tx == {
        'transactionId': command.targets.transactionId,
        'studentId': command.targets.studentId,
        'businessDate': command.targets.dayId,
        'type': 'refund',
        'mealKind': null,
        'mealPrice': 0,
        'paidAmount': 0,
        'amount': command.payload.amount,
        'studentNameSnapshot': studentName,
        'menuNameSnapshot': '',
        'menuPriceSnapshot': 0,
        'vendorIdSnapshot': '',
        'vendorNameSnapshot': '',
        'otherItemName': null,
        'status': 'active',
        'revision': 1,
        'createdAt': request.time,
        'createdSeq': seq,
        'operatorUid': request.auth.uid,
        'operatorEmail': request.auth.token.email,
        'sourceDevice': 'pc',
        'note': command.payload.reason,
        'lastCommandId': commandId,
        'updatedAt': request.time
      };
    }

    function validCreateRefund(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayId = command.targets.dayId;
      let studentId = command.targets.studentId;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      let studentBefore = get(/databases/$(database)/documents/students/$(studentId)).data;
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(studentId)).data;
      let transactionAfter = getAfter(/databases/$(database)/documents/transactions/$(command.targets.transactionId)).data;
      return commandHolder(command.leaseEpoch)
        && cashCommandEnvelope(commandId, command, head, headAfter)
        && command.kind == 'CreateRefund'
        && exactMap(command.targets, ['transactionId', 'studentId', 'dayId'])
        && validId(command.targets.transactionId)
        && validId(studentId)
        && studentId != '__cashier__'
        && validCalendarDate(dayId)
        && exactMap(command.expectedRevisions, ['transaction', 'student', 'day'])
        && command.expectedRevisions.transaction == 0
        && command.expectedRevisions.student == studentBefore.revision
        && command.expectedRevisions.day == dayBefore.revision
        && validRefundPayload(command.payload)
        && command.reason == command.payload.reason
        && command.cashEffect == {
          'before': 0, 'after': -command.payload.amount, 'delta': -command.payload.amount,
          'reasonKind': 'refund', 'refundAmount': command.payload.amount
        }
        && command.businessDate == dayId
        && command.studentId == studentId
        && command.before == {'head': head, 'student': studentBefore, 'day': dayBefore, 'transaction': null}
        && command.after == {'head': headAfter, 'student': studentAfter, 'day': dayAfter, 'transaction': transactionAfter}
        && !exists(/databases/$(database)/documents/transactions/$(command.targets.transactionId))
        && dayBefore.status in ['open', 'reopened']
        && dayId >= head.goLiveDate
        && validCurrentTaipeiDate(dayId)
        && studentBefore.openingBalance.asOfDate <= dayId
        && command.payload.amount <= studentBefore.currentBalance
        && studentAfter.revision == studentBefore.revision + 1
        && studentAfter.lastCommandId == commandId
        && studentAfter.updatedAt == request.time
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId
        && dayAfter.updatedAt == request.time
        && validRefundTransactionDoc(transactionAfter, commandId, command, head.seq + 1, studentBefore.displayName);
    }

    function validDayRefundProjection(commandId, command, dayId, before, after) {
      let beforeTotals = before.totals;
      let afterTotals = after.totals;
      return command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && validDay(after, dayId)
        && validTotals(beforeTotals)
        && before.status in ['open', 'reopened']
        && after.diff(before).affectedKeys().hasOnly(['revision', 'totals', 'lastCommandId', 'updatedAt'])
        && after.revision == before.revision + 1
        && afterTotals.activeTransactionCount == beforeTotals.activeTransactionCount + 1
        && afterTotals.bentoCount == beforeTotals.bentoCount
        && afterTotals.otherMealCount == beforeTotals.otherMealCount
        && afterTotals.mealTotal == beforeTotals.mealTotal
        && afterTotals.retainedReceipts == beforeTotals.retainedReceipts
        && afterTotals.cashierIncome == beforeTotals.cashierIncome
        && afterTotals.cashierExpense == beforeTotals.cashierExpense
        && afterTotals.accountRefunds == beforeTotals.accountRefunds + command.payload.amount
        && after.lastCommandId == commandId
        && after.updatedAt == request.time;
    }

    function validStudentRefund(commandId, command, before, after) {
      return before.openingBalance.asOfDate <= command.targets.dayId
        && after.diff(before).affectedKeys().hasOnly(['currentBalance', 'revision', 'lastCommandId', 'updatedAt'])
        && command.payload.amount is int && command.payload.amount >= 1
        && command.payload.amount <= before.currentBalance
        && after.currentBalance == before.currentBalance - command.payload.amount
        && after.revision == before.revision + 1
        && after.lastCommandId == commandId
        && after.updatedAt == request.time;
    }

    // P10a transaction mutations (spec §6.1, §7.1, §7.2): CorrectTransaction, VoidTransaction,
    // CancelKeepDeposit, CancelRefund and Undo rewrite one existing active transaction in place.
    // The command rule binds every before/after snapshot to the real documents and fixes the cash
    // effect; the transaction, student and day rules each check their own transition from those
    // snapshots. The transaction keeps its account, business date, creation time and creation seq.
    // Command dispatch. `kind` is bound once: each branch costs one comparison, not a
    // request.resource.data lookup, which keeps the later (mutation) branches under the
    // 1,000-expression ceiling (see docs/ops/p05-rules-budget.md P10a appendix).
    function validCommandCreate(commandId, command) {
      let kind = command.kind;
      return (kind == 'EnsureDay' && validEnsureDay(commandId, command))
        || (kind == 'CreateStudent' && validCreateStudent(commandId, command))
        || (kind == 'ChangeStudentCode' && validChangeStudentCode(commandId, command))
        || (kind in ['EditStudent', 'SetStudentStatus'] && validStudentMutation(commandId, command))
        || (kind == 'SaveVendor' && validSaveVendor(commandId, command))
        || (kind == 'RemoveVendor' && validRemoveVendor(commandId, command))
        || (kind == 'SetDayMenu' && validSetDayMenu(commandId, command))
        || (kind == 'SetOpeningCash' && validSetOpeningCash(commandId, command))
        || (kind in ['CreateOrder', 'CreatePayment'] && validCreateTransaction(commandId, command))
        || (kind == 'CreateCashMovement' && validCreateCashMovement(commandId, command))
        || (kind == 'CreateRefund' && validCreateRefund(commandId, command))
        || (isMutationKind(kind) && validTransactionMutation(commandId, command))
        || (kind == 'RecordBackup'
          && validRecordBackup(commandId, command, command.before.head, command.after.head))
        // P11 is nested inside the last operand: a new top-level `||` adds one expression to every
        // earlier kind (mutation and refund +19 → +18). A conditional here instead made the emulator
        // fail a malformed command with a retryable error rather than a denial.
        || ((kind == 'CorrectOpening' && validCorrectOpening(commandId, command))
          || (kind in ['CloseDay', 'ReopenDay'] && validDaySettlementCommand(commandId, command))
          || (kind == 'BackfillOpeningCash' && validBackfillOpeningCash(commandId, command)));
    }

    // BackfillOpeningCash: a past open／reopened day that never confirmed its opening cash (for
    // example the network was down that day) gets one afterwards, with a reason, so it can be closed.
    // SetOpeningCash stays limited to the Taipei today; this kind only fills a missing value on a
    // day before today and never changes a confirmed one. The day rule checks its own transition.
    function validBackfillOpeningCash(commandId, command) {
      let dayId = command.targets.dayId;
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      let p = command.payload;
      return commandHolder(command.leaseEpoch)
        && cashCommandEnvelope(commandId, command, head, headAfter)
        && exactMap(command.targets, ['dayId'])
        && exactMap(command.expectedRevisions, ['day'])
        && command.expectedRevisions.day == dayBefore.revision
        && validCalendarDate(dayId)
        && timestamp.value(dayId + 'T00:00:00Z') + duration.value(24, 'h') <= request.time + duration.value(8, 'h')
        && dayId >= head.goLiveDate
        && dayBefore.status in ['open', 'reopened']
        && dayBefore.openingCash == null
        && exactMap(p, ['openingCash', 'reason'])
        && p.openingCash is int && p.openingCash >= 0 && p.openingCash <= 20000
        && validMutationReason(p.reason)
        && command.reason == p.reason
        && command.businessDate == dayId
        && command.studentId == null
        && zeroCashEffect(command.cashEffect)
        && command.before == {'head': head, 'day': dayBefore}
        && command.after == {'head': headAfter, 'day': dayAfter}
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId;
    }

    // The day only gains its first opening cash; totals, menu, status and settlements stay.
    function dayBackfillOpeningCommand(commandId, dayId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return command.kind == 'BackfillOpeningCash'
        && !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && before.status in ['open', 'reopened']
        && before.openingCash == null && before.openedBy == null && before.openedAt == null
        && after.openingCash == command.payload.openingCash
        && after.openedBy == request.auth.uid && after.openedAt == request.time
        && after.diff(before).affectedKeys().hasOnly([
          'openingCash', 'openedBy', 'openedAt', 'revision', 'lastCommandId', 'updatedAt'
        ])
        && after.revision == before.revision + 1
        && after.updatedAt == request.time;
    }

    // P11 CloseDay／ReopenDay (spec §5 command table, §7.1 expectedCash and §7.4 day lifecycle). Each
    // command adds one immutable settlement version `days/{dayId}/settlements/{n}` with n = the day's
    // lastSettlementRevision + 1. CloseDay needs a confirmed openingCash and computes expectedCash from
    // the day totals; a non-zero difference needs a note. ReopenDay needs a reason. The command rule
    // binds every snapshot to the real documents; the day and settlement rules check their own shapes.
    function validDaySettlementCommand(commandId, command) {
      let dayId = command.targets.dayId;
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      let last = dayBefore.lastSettlementRevision;
      let previous = last == 0 ? null
        : get(/databases/$(database)/documents/days/$(dayId)/settlements/$(last)).data;
      let settlement = getAfter(/databases/$(database)/documents/days/$(dayId)/settlements/$(last + 1)).data;
      let close = command.kind == 'CloseDay';
      let p = command.payload;
      return commandHolder(command.leaseEpoch)
        && cashCommandEnvelope(commandId, command, head, headAfter)
        && exactMap(command.targets, ['dayId', 'settlementRevision'])
        && exactMap(command.expectedRevisions, ['day', 'settlement'])
        && command.expectedRevisions.day == dayBefore.revision
        && command.expectedRevisions.settlement == last
        && command.targets.settlementRevision == last + 1
        && validTaipeiDate(dayId)
        && command.businessDate == dayId
        && command.studentId == null
        && zeroCashEffect(command.cashEffect)
        && (close
          ? dayBefore.status in ['open', 'reopened']
            && dayBefore.openingCash is int
            && exactMap(p, ['countedCash', 'note', 'expectedCash'])
            && p.countedCash is int && p.countedCash >= 0 && p.countedCash <= 1000000000
            && p.note is string && p.note.size() <= 500
            && p.expectedCash == settlementExpectedCash(dayBefore)
            && (p.countedCash == p.expectedCash || p.note.size() >= 1)
            && command.reason == null
          : dayBefore.status == 'closed'
            && exactMap(p, ['reason'])
            && validMutationReason(p.reason)
            && command.reason == p.reason)
        && command.before == {'head': head, 'day': dayBefore, 'previousSettlement': previous}
        && command.after == {'head': headAfter, 'day': dayAfter, 'settlement': settlement}
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId
        && settlement.lastCommandId == commandId;
    }

    // Spec §7.1: expectedCash = openingCash + retainedReceipts + cashierIncome − cashierExpense − accountRefunds.
    function settlementExpectedCash(day) {
      let t = day.totals;
      return day.openingCash + t.retainedReceipts + t.cashierIncome - t.cashierExpense - t.accountRefunds;
    }

    // The day only changes its status, settlement pointer and revision; totals, menu and cash stay.
    function dayCloseCommand(commandId, dayId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      let close = command.kind == 'CloseDay';
      return command.kind in ['CloseDay', 'ReopenDay']
        && !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && (close ? before.status in ['open', 'reopened'] : before.status == 'closed')
        && after.status == (close ? 'closed' : 'reopened')
        && after.diff(before).affectedKeys().hasOnly(['status', 'lastSettlementRevision', 'revision', 'lastCommandId', 'updatedAt'])
        && after.lastSettlementRevision == before.lastSettlementRevision + 1
        && after.revision == before.revision + 1
        && after.updatedAt == request.time;
    }

    // One immutable settlement version, fully determined by the command and the day before it.
    function settlementCreateCommand(dayId, revision, settlement) {
      let commandId = settlement.lastCommandId;
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      let day = command.before.day;
      let close = command.kind == 'CloseDay';
      let expected = settlementExpectedCash(day);
      return command.kind in ['CloseDay', 'ReopenDay']
        && !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.targets.dayId == dayId
        && string(command.targets.settlementRevision) == revision
        && command.after.settlement == settlement
        && settlement == {
          'dayId': dayId,
          'revision': command.targets.settlementRevision,
          'status': close ? 'closed' : 'reopened',
          'totals': day.totals,
          'openingCash': day.openingCash,
          'expectedCash': expected,
          'countedCash': close ? command.payload.countedCash : null,
          'difference': close ? command.payload.countedCash - expected : null,
          'note': close ? command.payload.note : command.payload.reason,
          'actorUid': request.auth.uid,
          'actorEmail': request.auth.token.email,
          'sourceSeq': command.seq,
          'committedAt': request.time,
          'previousRevision': command.targets.settlementRevision - 1,
          'lastCommandId': commandId
        };
    }

    // P10b CorrectOpening (spec §5 command table and the §7 opening-correction rule): corrects a student's opening amount and note on the
    // original asOfDate. The asOfDate and createdAt never change, the cash effect is zero, and the
    // balance moves by the opening difference. The command rule binds every snapshot to the real
    // documents; the student and day rules check their own transitions from those snapshots.
    function validCorrectOpening(commandId, command) {
      let studentId = command.targets.studentId;
      let dayId = command.targets.dayId;
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let studentBefore = get(/databases/$(database)/documents/students/$(studentId)).data;
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(studentId)).data;
      let dayBefore = get(/databases/$(database)/documents/days/$(dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(dayId)).data;
      let p = command.payload;
      return commandHolder(command.leaseEpoch)
        && cashCommandEnvelope(commandId, command, head, headAfter)
        && exactMap(command.targets, ['studentId', 'dayId'])
        && exactMap(command.expectedRevisions, ['student', 'day'])
        && command.expectedRevisions.student == studentBefore.revision
        && command.expectedRevisions.day == dayBefore.revision
        && exactMap(p, ['amount', 'note', 'reason'])
        && p.amount is int && p.amount >= -1000000000 && p.amount <= 1000000000
        && p.note is string && p.note.size() <= 500
        && validMutationReason(p.reason)
        && command.reason == p.reason
        && command.businessDate == dayId
        && command.studentId == studentId
        && studentBefore.openingBalance.asOfDate == dayId
        && dayBefore.status in ['open', 'reopened']
        && zeroCashEffect(command.cashEffect)
        && command.before == {'head': head, 'student': studentBefore, 'day': dayBefore}
        && command.after == {'head': headAfter, 'student': studentAfter, 'day': dayAfter}
        && studentAfter.revision == studentBefore.revision + 1
        && studentAfter.lastCommandId == commandId
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId;
    }

    // Only the opening amount and note change; the balance moves by the same difference.
    function validStudentOpeningCorrection(commandId, command, before, after) {
      let p = command.payload;
      return after.diff(before).affectedKeys().hasOnly(['openingBalance', 'currentBalance', 'revision', 'lastCommandId', 'updatedAt'])
        && after.openingBalance == {
          'amount': p.amount, 'asOfDate': before.openingBalance.asOfDate,
          'note': p.note, 'createdAt': before.openingBalance.createdAt
        }
        && after.openingBalance != before.openingBalance
        && after.currentBalance == before.currentBalance - before.openingBalance.amount + p.amount
        && after.revision == before.revision + 1
        && after.lastCommandId == commandId
        && after.updatedAt == request.time;
    }

    function isMutationKind(kind) {
      return kind in ['CorrectTransaction', 'VoidTransaction', 'CancelKeepDeposit', 'CancelRefund', 'Undo'];
    }

    // Spec §7.1 cash contribution: order/payment paidAmount, expense paidAmount - mealPrice,
    // refund -amount, voided 0.
    function cashContribution(tx) {
      return tx.status != 'active' ? 0
        : tx.type == 'expense' ? tx.paidAmount - tx.mealPrice
        : tx.type == 'refund' ? -tx.amount
        : tx.paidAmount;
    }

    // Student balance contribution: order/payment amount (= paidAmount - mealPrice), refund -amount, voided 0.
    function studentContribution(tx) {
      return tx.status != 'active' ? 0 : (tx.type == 'refund' ? -tx.amount : tx.amount);
    }

    // Spec §7.1/§7.2 reasonKind: a correction or void records a book change; cancelling with a refund or
    // undoing a collected order/payment returns that cash; undoing counter cash or a refund reverses it.
    function mutationCashEffect(kind, before, after) {
      let b = cashContribution(before);
      let a = cashContribution(after);
      let reasonKind = kind == 'CorrectTransaction' ? (a == b ? 'none' : 'correction')
        : kind == 'VoidTransaction' ? (b == 0 ? 'none' : 'correction')
        : kind == 'CancelKeepDeposit' ? 'none'
        : before.type in ['expense', 'refund'] ? 'reversal'
        : before.paidAmount > 0 ? 'refund' : 'none';
      return {
        'before': b, 'after': a, 'delta': a - b, 'reasonKind': reasonKind,
        'refundAmount': reasonKind == 'refund' ? before.paidAmount : 0
      };
    }

    function validMutationReason(reason) {
      return reason is string && reason.size() >= 1 && reason.size() <= 500;
    }

    function validMutationPayload(command) {
      let p = command.payload;
      return command.kind == 'CorrectTransaction'
        ? exactMap(p, ['mealPrice', 'paidAmount', 'amount', 'note', 'reason'])
          && p.mealPrice is int && p.mealPrice >= 0 && p.mealPrice <= 1000000
          && p.paidAmount is int && p.paidAmount >= 0 && p.paidAmount <= 1000000
          && p.amount is int && p.amount >= -1000000 && p.amount <= 1000000
          && p.note is string && p.note.size() <= 500
          && validMutationReason(p.reason)
        : command.kind == 'Undo'
          ? exactMap(p, ['targetCommandId', 'reason'])
            && validCommandId(p.targetCommandId)
            && p.reason == '送出後立即撤回'
          : exactMap(p, ['reason']) && validMutationReason(p.reason);
    }

    // Called only after the caller has bound command.before/after to the real documents.
    // Omitted on purpose (already guaranteed, and the command rule is near the expression ceiling):
    // the kind (dispatch checked it); transactionId format, dayId calendar format and goLiveDate
    // (txBefore exists with businessDate == dayId, and both were validated when it was created;
    // goLiveDate cannot change); txAfter.lastCommandId (the transaction update rule requires it, and
    // the revision bump below proves that write is in this batch).
    function validTransactionMutationCommon(commandId, command) {
      let dayId = command.targets.dayId;
      let head = command.before.head;
      let headAfter = command.after.head;
      let txBefore = command.before.transaction;
      let txAfter = command.after.transaction;
      let dayBefore = command.before.day;
      let dayAfter = command.after.day;
      return commandHolder(command.leaseEpoch)
        && cashCommandEnvelope(commandId, command, head, headAfter)
        && exactMap(command.targets, ['transactionId', 'studentId', 'dayId'])
        && command.expectedRevisions.transaction == txBefore.revision
        && command.expectedRevisions.day == dayBefore.revision
        && validMutationPayload(command)
        && command.reason == command.payload.reason
        && command.businessDate == dayId
        && command.studentId == command.targets.studentId
        && txBefore.businessDate == dayId
        && txBefore.studentId == command.targets.studentId
        && txBefore.status == 'active'
        && dayBefore.status in ['open', 'reopened']
        // Cash goes back over the counter only for a row of today's Taipei date (spec §7.2).
        && (!(command.kind in ['CancelRefund', 'Undo']) || validCurrentTaipeiDate(dayId))
        && txAfter.revision == txBefore.revision + 1
        && dayAfter.revision == dayBefore.revision + 1
        && dayAfter.lastCommandId == commandId
        && command.cashEffect == mutationCashEffect(command.kind, txBefore, txAfter);
    }

    function validCashierTransactionMutation(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayBefore = get(/databases/$(database)/documents/days/$(command.targets.dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(command.targets.dayId)).data;
      let txBefore = get(/databases/$(database)/documents/transactions/$(command.targets.transactionId)).data;
      let txAfter = getAfter(/databases/$(database)/documents/transactions/$(command.targets.transactionId)).data;
      return exactMap(command.expectedRevisions, ['transaction', 'day'])
        && txBefore.type == 'expense'
        && command.before == {'head': head, 'day': dayBefore, 'transaction': txBefore}
        && command.after == {'head': headAfter, 'day': dayAfter, 'transaction': txAfter}
        && validTransactionMutationCommon(commandId, command);
    }

    function validStudentTransactionMutation(commandId, command) {
      let head = get(/databases/$(database)/documents/system/dataHead).data;
      let headAfter = getAfter(/databases/$(database)/documents/system/dataHead).data;
      let dayBefore = get(/databases/$(database)/documents/days/$(command.targets.dayId)).data;
      let dayAfter = getAfter(/databases/$(database)/documents/days/$(command.targets.dayId)).data;
      let studentBefore = get(/databases/$(database)/documents/students/$(command.targets.studentId)).data;
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(command.targets.studentId)).data;
      let txBefore = get(/databases/$(database)/documents/transactions/$(command.targets.transactionId)).data;
      let txAfter = getAfter(/databases/$(database)/documents/transactions/$(command.targets.transactionId)).data;
      // Not an expense: txBefore.studentId == targets.studentId != '__cashier__', and every expense row
      // belongs to '__cashier__'.
      return exactMap(command.expectedRevisions, ['transaction', 'student', 'day'])
        && command.expectedRevisions.student == studentBefore.revision
        && command.before == {'head': head, 'student': studentBefore, 'day': dayBefore, 'transaction': txBefore}
        && command.after == {'head': headAfter, 'student': studentAfter, 'day': dayAfter, 'transaction': txAfter}
        && studentAfter.revision == studentBefore.revision + 1
        && studentAfter.lastCommandId == commandId
        && validTransactionMutationCommon(commandId, command);
    }

    function validTransactionMutation(commandId, command) {
      return command.targets.studentId == '__cashier__'
        ? validCashierTransactionMutation(commandId, command)
        : validStudentTransactionMutation(commandId, command);
    }

    // CorrectTransaction may change only mealPrice / paidAmount / amount / note, keeping the row's type
    // (spec §6.1): payment stays > 0 (zero means void), expense keeps its direction, refund stays a
    // positive amount; expense and refund rows keep a non-empty note (their reason).
    function validCorrectedTransaction(before, after, payload) {
      return after.diff(before).affectedKeys().hasOnly(['mealPrice', 'paidAmount', 'amount', 'note', 'revision', 'lastCommandId', 'updatedAt'])
        && after.diff(before).affectedKeys().hasAny(['mealPrice', 'paidAmount', 'amount', 'note'])
        && after.mealPrice == payload.mealPrice
        && after.paidAmount == payload.paidAmount
        && after.amount == payload.amount
        && after.note == payload.note
        && (before.type == 'refund'
          ? payload.mealPrice == 0 && payload.paidAmount == 0 && payload.amount >= 1 && payload.note.size() >= 1
          : payload.amount == payload.paidAmount - payload.mealPrice
            && (before.type == 'order'
              || (before.type == 'payment' && payload.mealPrice == 0 && payload.paidAmount >= 1)
              || (before.type == 'expense' && payload.note.size() >= 1
                && (before.paidAmount > 0
                  ? payload.mealPrice == 0 && payload.paidAmount >= 1
                  : payload.paidAmount == 0 && payload.mealPrice >= 1))));
    }

    // CancelKeepDeposit on an order with money: the row becomes that payment, meal and snapshots cleared.
    function validKeepDepositTransaction(before, after) {
      return before.type == 'order'
        && after.diff(before).affectedKeys().hasOnly([
          'type', 'mealKind', 'mealPrice', 'amount', 'menuNameSnapshot', 'menuPriceSnapshot',
          'vendorIdSnapshot', 'vendorNameSnapshot', 'otherItemName', 'revision', 'lastCommandId', 'updatedAt'
        ])
        && after.type == 'payment'
        && after.mealKind == null
        && after.mealPrice == 0
        && after.amount == before.paidAmount
        && after.menuNameSnapshot == ''
        && after.menuPriceSnapshot == 0
        && after.vendorIdSnapshot == ''
        && after.vendorNameSnapshot == ''
        && after.otherItemName == null;
    }

    function transactionMutationCommand(commandId, transactionId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      let kind = command.kind;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && isMutationKind(kind)
        && command.targets.transactionId == transactionId
        && command.before.transaction == before
        && command.after.transaction == after
        && before.status == 'active'
        && after.revision == before.revision + 1
        && after.lastCommandId == commandId
        && after.updatedAt == request.time
        && (kind == 'CorrectTransaction'
          ? validCorrectedTransaction(before, after, command.payload)
          : kind == 'CancelKeepDeposit' && before.paidAmount > 0
            ? validKeepDepositTransaction(before, after)
            : after.diff(before).affectedKeys().hasOnly(['status', 'revision', 'lastCommandId', 'updatedAt'])
              && after.status == 'voided'
              && (!(kind in ['CancelKeepDeposit', 'CancelRefund']) || before.type == 'order')
              // Undo: only the creator's untouched row, named by its creating command (spec §7.2).
              && (kind != 'Undo'
                || (before.revision == 1
                  && before.operatorUid == request.auth.uid
                  && before.lastCommandId == command.payload.targetCommandId)));
    }

    function validStudentMutationBalance(commandId, command, before, after) {
      let txBefore = command.before.transaction;
      let txAfter = command.after.transaction;
      return after.diff(before).affectedKeys().hasOnly(['currentBalance', 'revision', 'lastCommandId', 'updatedAt'])
        && after.currentBalance == before.currentBalance - studentContribution(txBefore) + studentContribution(txAfter)
        && after.revision == before.revision + 1
        && after.lastCommandId == commandId
        && after.updatedAt == request.time
        // A refund is never corrected upward into debt (P09b rule: no refund beyond the balance).
        && (command.kind != 'CorrectTransaction' || txBefore.type != 'refund'
          || txAfter.amount <= txBefore.amount || after.currentBalance >= 0);
    }

    // The same contribution as spec §7.1 / reconcileDayTotals; a voided row contributes nothing.
    function totalsContribution(tx) {
      let on = tx.status == 'active';
      let order = on && tx.type == 'order';
      let expense = on && tx.type == 'expense';
      return {
        'activeTransactionCount': on ? 1 : 0,
        'bentoCount': order && tx.mealKind == 'bento' ? 1 : 0,
        'otherMealCount': order && tx.mealKind == 'other' ? 1 : 0,
        'mealTotal': order ? tx.mealPrice : 0,
        'retainedReceipts': on && tx.type in ['order', 'payment'] ? tx.paidAmount : 0,
        'cashierIncome': expense ? tx.paidAmount : 0,
        'cashierExpense': expense ? tx.mealPrice : 0,
        'accountRefunds': on && tx.type == 'refund' ? tx.amount : 0
      };
    }

    function validDayMutationProjection(commandId, command, dayId, before, after) {
      let b = before.totals;
      let x = totalsContribution(command.before.transaction);
      let y = totalsContribution(command.after.transaction);
      return command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && before.status in ['open', 'reopened']
        && after.diff(before).affectedKeys().hasOnly(['revision', 'totals', 'lastCommandId', 'updatedAt'])
        && after.lastCommandId == commandId
        && validTotals(after.totals)
        && after.totals == {
          'activeTransactionCount': b.activeTransactionCount - x.activeTransactionCount + y.activeTransactionCount,
          'bentoCount': b.bentoCount - x.bentoCount + y.bentoCount,
          'otherMealCount': b.otherMealCount - x.otherMealCount + y.otherMealCount,
          'mealTotal': b.mealTotal - x.mealTotal + y.mealTotal,
          'retainedReceipts': b.retainedReceipts - x.retainedReceipts + y.retainedReceipts,
          'cashierIncome': b.cashierIncome - x.cashierIncome + y.cashierIncome,
          'cashierExpense': b.cashierExpense - x.cashierExpense + y.cashierExpense,
          'accountRefunds': b.accountRefunds - x.accountRefunds + y.accountRefunds
        };
    }

    function headCommand(commandId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && headInheritedMenuSourceDay(command)
        && (command.kind != 'RecordBackup' || validRecordBackup(commandId, command, before, after));
    }

    function validRecordBackup(commandId, command, headBefore, headAfter) {
      let lease = get(/databases/$(database)/documents/system/accessLease).data;
      let actualHead = get(/databases/$(database)/documents/system/dataHead).data;
      let committedHead = getAfter(/databases/$(database)/documents/system/dataHead).data;
      return currentHolder()
        && exactMap(command, [
          'commandId', 'kind', 'seq', 'leaseEpoch', 'actor', 'committedAt', 'businessDate',
          'studentId', 'targets', 'expectedRevisions', 'before', 'after', 'reason',
          'cashEffect', 'payload', 'inputFingerprint'
        ])
        && commandId == command.commandId && command.kind == 'RecordBackup'
        && command.seq == headBefore.seq + 1 && command.leaseEpoch == lease.epoch
        && command.actor is map && exactMap(command.actor, ['uid', 'email'])
        && command.actor.uid == request.auth.uid && command.actor.email == request.auth.token.email
        && command.committedAt == request.time && command.businessDate == null && command.studentId == null
        && exactMap(command.targets, []) && exactMap(command.expectedRevisions, [])
        && exactMap(command.payload, ['backupType', 'sourceSeq', 'fromSeq', 'toSeq', 'sha256'])
        && command.payload.backupType == 'command-incremental'
        && command.payload.sourceSeq is int && command.payload.sourceSeq >= 0
        && command.payload.sourceSeq <= headBefore.seq
        && command.payload.fromSeq is int && command.payload.fromSeq >= 0
        && command.payload.fromSeq <= command.payload.toSeq
        && command.payload.toSeq == command.payload.sourceSeq
        && command.payload.sha256 is string && command.payload.sha256.matches('^[a-f0-9]{64}$')
        && command.inputFingerprint is string && command.inputFingerprint.matches('^[a-f0-9]{64}$')
        && command.reason == null
        && exactMap(command.cashEffect, ['before', 'after', 'delta', 'reasonKind', 'refundAmount'])
        && command.cashEffect.before == 0 && command.cashEffect.after == 0 && command.cashEffect.delta == 0
        && command.cashEffect.reasonKind == 'none' && command.cashEffect.refundAmount == 0
        && exactMap(command.before, ['head']) && command.before.head == headBefore
        && exactMap(command.after, ['head']) && command.after.head == headAfter
        && headBefore == actualHead
        && committedHead.seq == command.seq && committedHead.lastCommandId == commandId
        && committedHead.updatedAt == request.time;
    }

    // Firestore applies its 1,000-expression ceiling to each document's rule evaluation. An
    // inherited SetDayMenu cannot validate the target day, the complete source day and the vendor
    // within the day write alone, so the source day's full schema is validated here, on the dataHead
    // write that every command commit must include. All checks still bind the same atomic commit.
    function headInheritedMenuSourceDay(command) {
      return command.kind != 'SetDayMenu'
        || command.payload.inheritedFromDate == null
        || validDay(
          get(/databases/$(database)/documents/days/$(command.payload.inheritedFromDate)).data,
          command.payload.inheritedFromDate
        );
    }

    function ensureDayCommand(commandId, dayId, dayAfter) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.kind == 'EnsureDay'
        && command.targets.dayId == dayId
        && command.before.day == null
        && command.after.day == dayAfter;
    }

    function validDayTransactionProjection(commandId, command, dayId, before, after) {
      let order = command.kind == 'CreateOrder';
      let mealPrice = order ? command.payload.mealPrice : 0;
      return command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && validDayAdvance(commandId, command, before, after, mealPrice, order);
    }

    function validDaySetMenuProjection(command, dayId, before, after) {
      return command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && after.diff(before).affectedKeys().hasOnly(['menu', 'revision', 'lastCommandId', 'updatedAt'])
        && (command.payload.inheritedFromDate == null
          ? validDay(after, dayId)
          : validDayNonMenu(after))
        && before.keys().hasAll([
          'status', 'revision', 'menu', 'openingCash', 'openedBy', 'openedAt',
          'totals', 'lastSettlementRevision', 'lastCommandId', 'updatedAt'
        ])
        && (before.menu == null || validMenu(before.menu, dayId))
        && before.status in ['open', 'reopened']
        && before.revision is int && before.revision >= 1
        && before.lastCommandId is string
        && before.updatedAt is timestamp
        && (command.payload.inheritedFromDate == null
          || validSetDayMenuInheritedBusiness(command, dayId, before, after));
    }

    function validDayOpeningCashProjection(command, dayId, before, after) {
      let firstConfirmation = before.openingCash == null;
      return command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && validDay(before, dayId)
        && before.status in ['open', 'reopened']
        && (firstConfirmation
          ? before.openedBy == null && before.openedAt == null
            && after.openedBy == request.auth.uid && after.openedAt == request.time
          : before.openedBy is string && before.openedAt is timestamp
            && after.openedBy == before.openedBy && after.openedAt == before.openedAt)
        && after.diff(before).affectedKeys().hasOnly([
          'openingCash', 'openedBy', 'openedAt', 'revision', 'lastCommandId', 'updatedAt'
        ]);
    }

    function dayWriteCommand(commandId, dayId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return (command.kind in ['CreateOrder', 'CreatePayment', 'SetDayMenu', 'SetOpeningCash']
          || command.kind == 'CreateCashMovement'
          || command.kind == 'CreateRefund'
          || isMutationKind(command.kind))
        && !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && ((command.kind in ['CreateOrder', 'CreatePayment']
            && validDayTransactionProjection(commandId, command, dayId, before, after))
          || (command.kind == 'SetDayMenu'
            && validDaySetMenuProjection(command, dayId, before, after))
          || (command.kind == 'SetOpeningCash'
            && validDayOpeningCashProjection(command, dayId, before, after))
          || (command.kind == 'CreateCashMovement'
            && validDayCashMovementProjection(commandId, command, dayId, before, after))
          || (command.kind == 'CreateRefund'
            && validDayRefundProjection(commandId, command, dayId, before, after))
          || (isMutationKind(command.kind)
            && validDayMutationProjection(commandId, command, dayId, before, after)));
    }

    // CorrectOpening only records the change on the opening date: no totals, menu or cash. It has its
    // own `allow update` so the existing day branches keep their expression headroom.
    function dayOpeningCorrectionCommand(commandId, dayId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return command.kind == 'CorrectOpening'
        && !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.targets.dayId == dayId
        && command.before.day == before
        && command.after.day == after
        && before.status in ['open', 'reopened']
        && after.diff(before).affectedKeys().hasOnly(['revision', 'lastCommandId', 'updatedAt'])
        && after.revision == before.revision + 1
        && after.updatedAt == request.time;
    }

    function studentWriteCommand(commandId, studentId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      let mealPrice = command.kind == 'CreateOrder' ? command.payload.mealPrice : 0;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.targets.studentId == studentId
        && command.before.student == before
        && command.after.student == after
        && ((command.kind in ['CreateOrder', 'CreatePayment']
          && command.expectedRevisions.student == before.revision
          && validStudentAdvance(commandId, command, before, after, mealPrice))
          || (command.kind in ['EditStudent', 'SetStudentStatus', 'ChangeStudentCode']
            && command.expectedRevisions.student == before.revision)
          || (command.kind == 'CreateRefund'
            && command.expectedRevisions.student == before.revision
            && validStudentRefund(commandId, command, before, after))
          || (isMutationKind(command.kind)
            && command.expectedRevisions.student == before.revision
            && validStudentMutationBalance(commandId, command, before, after))
          || (command.kind == 'CorrectOpening'
            && command.expectedRevisions.student == before.revision
            && validStudentOpeningCorrection(commandId, command, before, after)));
    }

    function studentCreateCommand(commandId, studentId, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.kind == 'CreateStudent'
        && command.targets.studentId == studentId
        && command.payload.studentCode == after.studentCode
        && command.before.student == null
        && command.after.student == after;
    }

    function studentCodeCreateCommand(commandId, code, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.kind in ['CreateStudent', 'ChangeStudentCode']
        && command.payload.studentCode == code
        && command.targets.studentId == after.studentId
        && command.after.student.studentCode == code
        && after.lastCommandId == commandId
        && after.updatedAt == request.time
        && exactMap(after, ['studentId', 'lastCommandId', 'updatedAt']);
    }

    function studentCodeDeleteCommand(code, beforeData) {
      let studentAfter = getAfter(/databases/$(database)/documents/students/$(beforeData.studentId)).data;
      let commandId = studentAfter.lastCommandId;
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.kind == 'ChangeStudentCode'
        && command.targets.studentId == beforeData.studentId
        && command.before.student.studentCode == code
        && command.after.student.studentCode != code
        && command.after.student.studentCode == command.payload.studentCode
        && studentAfter.studentCode == command.payload.studentCode;
    }

    function transactionCommand(commandId, transactionId, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.targets.transactionId == transactionId
        && command.before.transaction == null
        && command.after.transaction == after
        && ((command.kind in ['CreateOrder', 'CreatePayment']
            && validTransactionPayload(
              commandId,
              command,
              command.before.head,
              command.before.day,
              command.before.student,
              after
            ))
          || (command.kind == 'CreateCashMovement'
            && validCashMovementPayload(command.payload)
            && command.before.day.status in ['open', 'reopened']
            && validCurrentTaipeiDate(command.targets.dayId)
            && command.targets.dayId >= command.before.head.goLiveDate
            && validCashMovementTransactionDoc(after, commandId, command, command.before.head.seq + 1))
          || (command.kind == 'CreateRefund'
            && validRefundPayload(command.payload)
            && command.before.day.status in ['open', 'reopened']
            && validCurrentTaipeiDate(command.targets.dayId)
            && command.targets.dayId >= command.before.head.goLiveDate
            && validRefundTransactionDoc(after, commandId, command, command.before.head.seq + 1, command.before.student.displayName)));
    }

    function vendorCreateCommand(commandId, vendorId, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.kind == 'SaveVendor'
        && command.targets.vendorId == vendorId
        && command.after.vendor == after;
    }

    function vendorUpdateCommand(commandId, vendorId, before, after) {
      let command = getAfter(/databases/$(database)/documents/commands/$(commandId)).data;
      return !exists(/databases/$(database)/documents/commands/$(commandId))
        && command.commandId == commandId
        && command.committedAt == request.time
        && command.kind in ['SaveVendor', 'RemoveVendor']
        && command.targets.vendorId == vendorId
        && command.before.vendor == before
        && command.after.vendor == after
        && (command.kind == 'SaveVendor'
          ? before.deleted == false && after.deleted == false
            && after.diff(before).affectedKeys().hasOnly([
              'name', 'phone', 'note', 'status', 'revision', 'lastCommandId', 'updatedAt'
            ])
          : before.deleted == false && before.status == 'inactive'
            && after.deleted == true && after.status == 'inactive'
            && after.lastCommandId == commandId
            && command.expectedRevisions.vendor == before.revision
            && exactMap(command.payload, ['reason'])
            && command.reason == command.payload.reason
            && after.diff(before).affectedKeys().hasOnly(['deleted', 'revision', 'lastCommandId', 'updatedAt']));
    }

    // Operators are provisioned by the maintainer. Clients cannot mutate this allowlist.
    match /operators/{uid} {
      allow get: if signedGoogle() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // P04 global lease state machine.
    match /system/accessLease {
      allow get: if approvedOperator();
      allow list, create, delete: if false;
      allow update: if approvedOperator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['holderUid', 'epoch', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          ((resource.data.holderUid == null || resource.data.updatedAt + duration.value(5, 'm') <= request.time)
            && request.resource.data.holderUid == request.auth.uid
            && request.resource.data.epoch == resource.data.epoch + 1)
          || (resource.data.holderUid == request.auth.uid
            && resource.data.updatedAt + duration.value(5, 'm') > request.time
            && request.resource.data.holderUid == request.auth.uid
            && request.resource.data.epoch == resource.data.epoch)
          || (resource.data.holderUid == request.auth.uid
            && request.resource.data.holderUid == null
            && request.resource.data.epoch == resource.data.epoch + 1)
        );
    }

    match /system/dataHead {
      allow get: if currentHolder();
      allow list, create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq', 'lastCommandId', 'updatedAt'])
        && headCommand(request.resource.data.lastCommandId, resource.data, request.resource.data)
        && validHeadAdvance(resource.data, request.resource.data, request.resource.data.lastCommandId);
    }

    match /commands/{commandId} {
      allow get: if currentHolder();
      allow list: if currentHolder();
      allow update, delete: if false;
      allow create: if commandId == request.resource.data.commandId
        && validCommandCreate(commandId, request.resource.data);
    }

    match /days/{dayId} {
      allow get: if currentHolder();
      allow list: if currentHolder();
      allow delete: if false;
      allow create: if request.resource.data.lastCommandId is string
        && ensureDayCommand(request.resource.data.lastCommandId, dayId, request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow update: if (request.resource.data.lastCommandId is string)
        && dayWriteCommand(request.resource.data.lastCommandId, dayId, resource.data, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'revision', 'totals', 'menu', 'openingCash', 'openedBy', 'openedAt', 'lastCommandId', 'updatedAt'
        ])
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
      allow update: if request.resource.data.lastCommandId is string
        && dayOpeningCorrectionCommand(request.resource.data.lastCommandId, dayId, resource.data, request.resource.data);
      // P11: CloseDay／ReopenDay have their own rule so the other day branches keep their headroom.
      allow update: if request.resource.data.lastCommandId is string
        && dayCloseCommand(request.resource.data.lastCommandId, dayId, resource.data, request.resource.data);
      // Opening cash backfilled on a past day: its own rule, like CorrectOpening and CloseDay.
      allow update: if request.resource.data.lastCommandId is string
        && dayBackfillOpeningCommand(request.resource.data.lastCommandId, dayId, resource.data, request.resource.data);
    }

    // P11 immutable settlement versions: created once by CloseDay／ReopenDay, never changed or deleted.
    match /days/{dayId}/settlements/{revision} {
      allow get, list: if currentHolder();
      allow update, delete: if false;
      allow create: if request.resource.data.lastCommandId is string
        && settlementCreateCommand(dayId, revision, request.resource.data);
    }

    match /students/{studentId} {
      // Query authorization cannot filter by student schema; every returned record is
      // strict-decoded by the server-only repository before any UI state is published.
      allow get, list: if currentHolder();
      allow create: if request.resource.data.lastCommandId is string
        && studentCreateCommand(request.resource.data.lastCommandId, studentId, request.resource.data)
        && validStudent(request.resource.data, studentId);
      allow delete: if false;
      allow update: if request.resource.data.lastCommandId is string
        && studentWriteCommand(request.resource.data.lastCommandId, studentId, resource.data, request.resource.data)
        // Every command branch above fixes its own changed keys; only CorrectOpening touches openingBalance.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentBalance', 'displayName', 'aliases', 'status', 'studentCode', 'openingBalance',
          'revision', 'lastCommandId', 'updatedAt'
        ])
        && validStudent(request.resource.data, studentId)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
    }

    match /studentCodes/{code} {
      allow get, list: if currentHolder();
      allow create: if request.resource.data.lastCommandId is string
        && validStudentCode(code)
        && studentCodeCreateCommand(request.resource.data.lastCommandId, code, request.resource.data);
      allow delete: if studentCodeDeleteCommand(code, resource.data);
      allow update: if false;
    }

    match /transactions/{transactionId} {
      allow get, list: if currentHolder();
      allow delete: if false;
      // P10a: an existing row changes only through a mutation command; nothing is ever deleted.
      allow update: if request.resource.data.lastCommandId is string
        && transactionMutationCommand(request.resource.data.lastCommandId, transactionId, resource.data, request.resource.data);
      allow create: if request.resource.data.lastCommandId is string
        && transactionCommand(request.resource.data.lastCommandId, transactionId, request.resource.data)
        && validId(transactionId);
    }

    match /vendors/{vendorId} {
      allow get, list: if currentHolder();
      allow create: if request.resource.data.lastCommandId is string
        && vendorCreateCommand(request.resource.data.lastCommandId, vendorId, request.resource.data)
        && validVendor(request.resource.data, vendorId)
        && request.resource.data.status == 'active'
        && request.resource.data.deleted == false
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.resource.data.lastCommandId is string
        && vendorUpdateCommand(request.resource.data.lastCommandId, vendorId, resource.data, request.resource.data)
        && validVendor(resource.data, vendorId)
        && validVendor(request.resource.data, vendorId)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /daily_settlements/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
